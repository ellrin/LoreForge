  "ticks": [
   4,
   7
  ],
  "padding": 0.05,
  "legend_order": [
   "emptiest inside corner",
   "outside top (one row)",
   "outside right"
  ],
  "legend_default": {
   "roc": "lower right",
   "pr": "lower left",
   "loss": "upper right",
   "accuracy": "lower right",
   "bar": "above",
   "scatter": "outside right"
  },
  "priority": [
   "the comparison is legible at print size",
   "nothing overlaps the data",
   "minimum font sizes",
   "fewer decorations"
  ]
 },
