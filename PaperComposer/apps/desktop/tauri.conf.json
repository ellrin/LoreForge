{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperComposer",
  "identifier": "io.github.ellrin.papercomposer",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../ui": "ui",
      "../../../private-example/PaperComposer": "workspace-template"
    },
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Word 文件",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": ["tex"],
        "name": "LaTeX 原始檔",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-tex"
      }
    ]
  }
}
